# CORS (Cross-Origin Resource Sharing)
#CORS_ALLOWED_ORIGINS=http://localhost:3000,http://your-frontend-domain.com
#CORS_AUTHORIZED_REDIRECT_URIS=http://localhost:3000/auth/callback

# Database (PostgreSQL)
SQL_DB_HOST=localhost
SQL_DB_PORT=5432
POSTGRES_DB=bus
SQL_DB_USER=postgres
SQL_DB_PASS=abc123

# Google OAuth
#GOOGLE_CLIENT_ID=your_google_client_id
#GOOGLE_CLIENT_SECRET=your_google_client_secret

# JWT
#JWT_SECRET=your_jwt_secret_key

# Server
SERVER_PORT=8080

# OpenTelemetry (for monitoring/tracing)
#OTLP_EXPORT_URL=http://localhost:4317
#OTLP_TRACE_URL=http://localhost:4318
#
## Kafka (for event-driven messaging)
#KAFKA_ADDRESSES=localhost:9092
#KAFKA_EXAMPLE_TOPIC=example-topic
